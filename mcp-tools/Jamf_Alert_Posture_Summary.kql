JamfProtectAlertsDemo_CL
| where TimeGenerated >= ago(7d)
| summarize
    TotalAlerts     = count(),
    PreventedCount  = countif(EventResult == "Prevented"),
    AllowedCount    = countif(EventResult == "Allowed"),
    HighAlerts      = countif(EventSeverity == "High"),
    MediumAlerts    = countif(EventSeverity == "Medium"),
    LowAlerts       = countif(EventSeverity == "Low"),
    UniqueHostnames = dcount(DvcHostname),
    EventTypes      = make_set(EventType, 20),
    TopActingProcs  = make_set(ActingProcessName, 10),
    FirstSeen       = min(TimeGenerated),
    LastSeen        = max(TimeGenerated)
